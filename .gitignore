# ============================================
# Root .gitignore (Mono-repo)
# ============================================

# === IDE ===
.vscode/
!.vscode/settings.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws

# === Agent ===
.agent/
.agents/

# === OS ===
.DS_Store
*.swp
*.tmp
*.temp
*~

# === Secrets & Environment ===
.env
.env.*
!.env.example
!**/.env.example
*.local
**/secrets/

# === Local docs ===
_local_docs/

# ============================================
# Flutter / Dart (app/)
# ============================================
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.packages
app/.pub-cache/
app/.pub/
app/devtools_options.yaml
*.log

# Generated Dart files (build_runner)
**/*.g.dart
**/*.freezed.dart
app/lib/core/di/injection.config.dart

# Android
app/android/.gradle/
app/android/build/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/
app/android/local.properties
**/problems-report.html
*.jks
*.keystore

# iOS
app/ios/.symlinks/
app/ios/Pods/
app/ios/Podfile.lock
app/ios/.cocoapods/
app/ios/Runner.xcworkspace/
app/ios/Flutter/Flutter.framework/
app/ios/Flutter/Flutter.podspec
app/ios/Flutter/AdMobLocal.xcconfig

# Web
app/web/.dart_tool/
app/web/drift_worker.js*

# Test
app/coverage/
app/.test_coverage.dart

# Build outputs
**/build/
*.apk
*.aab
*.ipa
*.app
*.dSYM.zip
*.dSYM

# Lock files (keep pubspec.lock)
*.lock
!app/pubspec.lock

# Isar
default.isar
default.isar.lock
isar.dll
*.isar-lck
test_*.isar*

# ============================================
# Go Backend (backend/)
# ============================================

# Binaries
backend/*.exe
backend/*.exe~
backend/*.dll
backend/*.so
backend/*.dylib
backend/bin/
backend/cmd/api/api
backend/cmd/api/api.exe

# Build & temp
backend/tmp/
backend/vendor/

# Test & Coverage
backend/*.test
backend/*.out
backend/coverage.*

# Debug
backend/__debug_bin*

# Swagger generated docs (可選擇是否追蹤)
# backend/docs/swagger.json
# backend/docs/swagger.yaml
# backend/docs/docs.go

# Docker
docker-compose.override.yml

# ============================================
# Hive Data Files (Local/Test)
# ============================================
**/*.hive
**/*.hive.lock

# Test Outputs
app/test_output*.txt
app/test_output*.xml

# legacy app (moved from app/)
legacy/app_legacy/.dart_tool/
legacy/app_legacy/.flutter-plugins
legacy/app_legacy/.flutter-plugins-dependencies
legacy/app_legacy/.packages
legacy/app_legacy/.pub-cache/
legacy/app_legacy/.pub/
legacy/app_legacy/devtools_options.yaml
legacy/app_legacy/lib/core/di/injection.config.dart
legacy/app_legacy/android/.gradle/
legacy/app_legacy/android/build/
legacy/app_legacy/android/app/debug/
legacy/app_legacy/android/app/profile/
legacy/app_legacy/android/app/release/
legacy/app_legacy/android/local.properties
legacy/app_legacy/ios/.symlinks/
legacy/app_legacy/ios/Pods/
legacy/app_legacy/ios/Podfile.lock
legacy/app_legacy/ios/.cocoapods/
legacy/app_legacy/ios/Runner.xcworkspace/
legacy/app_legacy/ios/Flutter/Flutter.framework/
legacy/app_legacy/ios/Flutter/Flutter.podspec
legacy/app_legacy/ios/Flutter/AdMobLocal.xcconfig
legacy/app_legacy/web/.dart_tool/
legacy/app_legacy/web/drift_worker.js*
legacy/app_legacy/coverage/
legacy/app_legacy/.test_coverage.dart
legacy/app_legacy/test_output*.txt
legacy/app_legacy/test_output*.xml
!legacy/app_legacy/pubspec.lock

# legacy backend (moved from backend/)
legacy/backend_legacy/*.exe
legacy/backend_legacy/*.exe~
legacy/backend_legacy/*.dll
legacy/backend_legacy/*.so
legacy/backend_legacy/*.dylib
legacy/backend_legacy/bin/
legacy/backend_legacy/cmd/api/api
legacy/backend_legacy/cmd/api/api.exe
legacy/backend_legacy/tmp/
legacy/backend_legacy/vendor/
legacy/backend_legacy/*.test
legacy/backend_legacy/*.out
legacy/backend_legacy/coverage.*
legacy/backend_legacy/__debug_bin*
