# Copy to .env (never commit real values). Loaded by your shell/IDE; the app reads real environment variables.
ENV=development
PORT=8080
# Either DATABASE_URL or the DB_* variables below.
# DATABASE_URL=postgres://user:password@localhost:5432/summitmate?sslmode=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev
DB_PASS=change-me
DB_NAME=summitmate
DB_SSLMODE=disable
# At least 32 characters.
JWT_SECRET=
# Optional (defaults shown)
# ACCESS_TOKEN_TTL=15m
# REFRESH_TOKEN_TTL=336h
# AUTH_CODE_TTL=30m
# BCRYPT_COST=12
