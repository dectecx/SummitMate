# SummitMate Go Backend Environment Variables Template
# Copy this file to .env or export these variables in your environment.

# Server
PORT=8080
ENV=development
HTTP_REQUEST_TIMEOUT=30s
SHUTDOWN_TIMEOUT=10s

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=dev
DB_PASS=dev2026!
DB_NAME=summitmate
DB_SSLMODE=disable

# Database Connection Pool
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=10s

# Auth & JWT (Secret must be at least 16 characters)
JWT_SECRET=dev_jwt_secret_change_in_production_min_16_chars
ACCESS_TOKEN_TTL=1h
REFRESH_TOKEN_TTL=336h

# CORS (Comma-separated origins)
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:54263,http://localhost,http://127.0.0.1,http://10.0.2.2

# Central Weather Administration (CWA) ETL
CWA_API_KEY=
CWA_HTTP_TIMEOUT=30s

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SummitMate <noreply@summitmate.com>
SMTP_USE_SSL=false
SMTP_WORKER_COUNT=3
SMTP_QUEUE_CAPACITY=50

# Cache
CACHE_TYPE=memory
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
